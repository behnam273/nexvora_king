# ==============================================================================
# NEXVORA — Trading Hub 3.0 Signal Engine, News Intelligence & PWA Backend
# ==============================================================================

# Environment: development | staging | production
NEXVORA_ENV=development

# Data mode:
#   live  = fetches real free market data (Twelve Data -> Yahoo Finance fallback) & real RSS feeds
#   demo  = explicitly labelled deterministic replay/backtest mode (for offline/sandbox verification)
#   auto  = tries live providers first, falls back to clearly labelled demo/replay if network blocked
NEXVORA_DATA_MODE=auto

# Database (SQLite local default; switch to PostgreSQL/Supabase in production)
# Example Supabase/Postgres (postgres:// is also auto-normalized for Railway):
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./nexvora.db

# Security (MUST change in production; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-in-production-use-64-char-random-secret
SESSION_TTL_HOURS=24
SESSION_IDLE_MINUTES=120
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Initial Admin Account (created only on first boot if DB has no admin)
INITIAL_ADMIN_EMAIL=admin@nexvora.local
INITIAL_ADMIN_PASSWORD=NexvoraAdmin!2026

# Free Market Data Providers (Automatic Multi-Provider Failover & Rate-Limit Cooldown)
# Default failover priority: oanda -> biquote (no-key, 15k req/min) -> twelvedata -> yahoo (no-key) -> alphavantage
MARKET_DATA_PROVIDERS=oanda,biquote,twelvedata,yahoo,alphavantage
# Optional: Free OANDA v20 Practice API token (TradingView-grade FX + XAUUSD, very high rate limit)
OANDA_API_TOKEN=
OANDA_ENV=practice
# Optional: Twelve Data key or comma-separated pool (auto-rotates keys & fails over immediately on 429/credit limit)
TWELVE_DATA_API_KEY=
TWELVE_DATA_API_KEYS=
# Optional: Alpha Vantage FX backup key
ALPHA_VANTAGE_API_KEY=
# Note: biquote.io (MT5 FX & Gold candles, 15,000 req/min) and Yahoo Finance require NO API key!

# Telegram Channel Integration
# Create a bot with @BotFather, add it as admin to your channel, set chat_id (e.g. -1001234567890 or @channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_DRY_RUN=true

# Optional LLM API for enhanced Persian news summarization (if empty, built-in Persian Forex NLP runs offline)
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Engine Scheduler Intervals (seconds)
ENGINE_SCAN_INTERVAL_SEC=120
POSITION_TRACK_INTERVAL_SEC=30
NEWS_FETCH_INTERVAL_SEC=300
BACKTEST_REFRESH_INTERVAL_SEC=3600

# Public PWA Base URL (included in Telegram signal links)
PWA_PUBLIC_URL=https://app.nexvora.example
